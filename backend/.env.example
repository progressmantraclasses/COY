# Backend settings. Copy this file to ".env" (same folder) and fill in MONGODB_URI.
# Without MONGODB_URI the API still runs, using in-memory storage (data resets on restart).
# Never commit .env: it holds your database password.

# Port the API listens on
PORT=4000

# Frontend URL(s) allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:3000

# MongoDB connection string (recommended), from MongoDB Atlas > Connect > Drivers. Looks like:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# Leave empty to use in-memory storage.
MONGODB_URI=
# Database name inside the cluster (created automatically)
MONGODB_DB=coy_discover

# Changes the (fixed) order of the Discover feed
FEED_SEED=20261119

# When fewer than 5 profiles are left, fetch real ones from randomuser.me (true/false)
PROFILE_REFILL=true

# Stop fetching new profiles once this many are stored (so the feed can end)
MAX_PROFILES=100
