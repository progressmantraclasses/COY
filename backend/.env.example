# Backend settings. Copy this file to ".env" (same folder) to use it.
# Every value is optional; the defaults below are what the app uses anyway.

# Port the API listens on
PORT=4000

# Frontend URL(s) allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:3000

# Where swipes and matches are saved (created automatically)
DATA_FILE=./data/db.json

# Changes the (fixed) shuffle order of the Discover feed
FEED_SEED=20261119
