{
  "name": "coy-discover",
  "private": true,
  "version": "1.0.0",
  "description": "Coy SDE intern assignment: a privacy-first swipe-based Discover tab (Next.js + NestJS).",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev -w backend\" \"npm:dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "concurrently -k -n api,web -c magenta,cyan \"npm:start -w backend\" \"npm:start -w frontend\"",
    "test": "npm run test -w backend && npm run test:e2e -w backend",
    "reset": "node -e \"try{process.loadEnvFile('backend/.env')}catch{}fetch('http://localhost:'+(process.env.PORT||4000)+'/reset',{method:'POST'}).then(r=>r.json()).then(console.log)\""
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
